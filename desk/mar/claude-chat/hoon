          allowed-tools.old
          created.old
      ==
        %0
      =/  old  ;;(chat-0:claude n)
      :*  %2
          id.old
          name.old
          parent.old
          children.old
          messages-by-time.old
          messages-by-index.old
          messages-by-chars.old
          next-index.old
          total-chars.old
